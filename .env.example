# Local development. In production set these in the hosting dashboard instead.
PORT=3000

# Database: a local file, or Turso (libsql://<db>-<org>.turso.io + DATABASE_AUTH_TOKEN)
DATABASE_URL=file:./data/dv-assist.db
DATABASE_AUTH_TOKEN=

# Generate these three with: npm run setup-secrets
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# false only for local http:// testing
SECURE_COOKIES=false
# true when running behind a hosting proxy (Render, Railway)
TRUST_PROXY=false

# Bitnob — the same host serves sandbox and live; the key decides which
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
BITNOB_SECRET_KEY=
# Id of the single Bitnob customer every card is issued to (POST /api/customers once)
BITNOB_CARD_CUSTOMER_ID=

# USD loaded on each card (Bitnob minimum $2). Must cover the official DV fee.
CARD_AMOUNT_USD=5
