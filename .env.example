# Local development. In production set these in the hosting dashboard instead.
PORT=3000

# Database: a local file, or Turso (libsql://<db>-<org>.turso.io + DATABASE_AUTH_TOKEN)
DATABASE_URL=file:./data/dv-assist.db
DATABASE_AUTH_TOKEN=

# Generate these three with: npm run setup-secrets
# ADMIN_EMAIL + ADMIN_PASSWORD_HASH create the first admin account, only when no staff exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# false only for local http:// testing
SECURE_COOKIES=false
# true when running behind a hosting proxy (Render, Railway)
TRUST_PROXY=false

# Bitnob — the same host serves sandbox and live; the key decides which
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
# "virtual" (minimum load $3) or "lite" ($2–$250; confirm the format in the sandbox first)
BITNOB_CARD_TYPE=virtual
# Optional: enables /api/webhooks/bitnob (HMAC-SHA512 signed by Bitnob)
BITNOB_WEBHOOK_SECRET=
BITNOB_SECRET_KEY=
# Id of the single Bitnob customer every card is issued to (POST /api/customers once)
BITNOB_CARD_CUSTOMER_ID=

# USD loaded on each card (Bitnob minimum $2). Must cover the official DV fee.
CARD_AMOUNT_USD=5

# Optional: what a referral partner earns per submitted entry, in whole birr. Unset = "to be confirmed".
PARTNER_COMMISSION_ETB=

# Optional messages. Without them, messages wait on the staff Messages page to be sent by hand.
# SMS (Ethiopian mobiles) via AfroMessage: token from the AfroMessage dashboard; identifier and sender
# name as registered there.
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=
# Email via Brevo: API key, and a sender address verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Ethio DV Assist
# Address used in links inside messages. On Render, RENDER_EXTERNAL_URL is used automatically.
PUBLIC_URL=

# Optional data retention, in days. Unset = that rule is off (nothing erased).
# Submitted entries, counted from submission (e.g. 548 ≈ 18 months, so selected applicants keep their data).
RETENTION_DAYS_AFTER_SUBMISSION=
# Website entries never sent for checking, and unused partner invitations (e.g. 60).
RETENTION_DAYS_UNSENT=
