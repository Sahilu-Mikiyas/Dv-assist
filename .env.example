PORT=3000
DB_PATH=./data/dv-assist.db

# Operator login
ADMIN_PASSWORD=change-me
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Set to false only for local http:// testing
SECURE_COOKIES=true

# Bitnob — sandbox by default; production is https://api.bitnob.co/api/v1
BITNOB_BASE_URL=https://sandboxapi.bitnob.co/api/v1
BITNOB_SECRET_KEY=
# Email of the card user registered (KYC'd) once in your Bitnob dashboard; all cards are issued under it
BITNOB_CARD_CUSTOMER_EMAIL=

# USD loaded on each card. Must cover the official DV fee plus card-side charges.
CARD_AMOUNT_USD=5
